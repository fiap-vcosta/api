# PostgreSQL
POSTGRES_DB=techchallenge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT (staff)
JWT_KEY=a-really-long-dummy-token-key-that-should-be-kept-secret
JWT_ISSUER=dummy-issuer
JWT_AUDIENCE=dummy-audience

# JWT cliente (Function auth assina; API valida — material separado do staff)
JWT_CLIENT_KEY=local-jwt-client-key-change-me-32chars-min
JWT_CLIENT_ISSUER=tech-challenge-client
JWT_CLIENT_AUDIENCE=tech-challenge-client

# Service auth (Function auth → API; header X-Service-Key)
SERVICE_AUTH_KEY=local-service-auth-key-change-me

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@techchallenge.com
PGADMIN_DEFAULT_PASSWORD=admin
