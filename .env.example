# PostgreSQL
POSTGRES_DB=techchallenge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT funcionario (staff — login Admin/Atendente/Mecanico)
JWT_FUNCIONARIO_KEY=a-really-long-dummy-token-key-that-should-be-kept-secret
JWT_FUNCIONARIO_ISSUER=dummy-issuer
JWT_FUNCIONARIO_AUDIENCE=dummy-audience

# JWT cliente (Function auth assina; API valida — material separado do funcionario)
JWT_CLIENTE_KEY=local-jwt-cliente-key-change-me-32chars-min
JWT_CLIENTE_ISSUER=tech-challenge-cliente
JWT_CLIENTE_AUDIENCE=tech-challenge-cliente

# Service auth (Function auth → API; header X-Service-Key)
SERVICE_AUTH_KEY=local-service-auth-key-change-me

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@techchallenge.com
PGADMIN_DEFAULT_PASSWORD=admin
