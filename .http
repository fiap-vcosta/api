### Login
# @name login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin"
}

### Define Token Variable
@token = {{login.response.body.$.token}}

### Health check
# @name healthCheck
GET http://localhost:8080/health

### GET Clientes
# @name getClientes
GET http://localhost:8080/api/cliente
Authorization: Bearer {{token}}

### Create Cliente
# @name createCliente
POST http://localhost:8080/api/cliente
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Nome": "Cliente Teste",
  "TipoDocumento": "0",
  "Documento": "92561324354"
}

### Define Cliente ID Variable
@clienteId = {{createCliente.response.body.$.id}}

### Get Cliente by ID
# @name getClienteById
GET http://localhost:8080/api/cliente/{{clienteId}}
Authorization: Bearer {{token}}

### Update Cliente by ID
# @name updateClienteById
PUT http://localhost:8080/api/cliente/{{clienteId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Nome": "Cliente Teste Atualizado",
  "TipoDocumento": "1",
  "Documento": "29040653186"
}

### Delete Cliente by ID
# @name deleteClienteById
DELETE http://localhost:8080/api/cliente/{{clienteId}}
Authorization: Bearer {{token}}

### GET Veiculos
# @name getVeiculos
GET http://localhost:8080/api/veiculo
Authorization: Bearer {{token}}

### Create Veiculo
# @name createVeiculo
POST http://localhost:8080/api/veiculo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Placa": "ABC-1D23",
  "DonoId": {{clienteId}},
  "Modelo": "Gol",
  "Marca": "Volkswagen"
}

### Define Veiculo ID Variable
@veiculoId = {{createVeiculo.response.body.$.id}}

### Get Veiculo by ID
# @name getVeiculoById
GET http://localhost:8080/api/veiculo/{{veiculoId}}
Authorization: Bearer {{token}}

### Get Veiculos by Dono
# @name getVeiculosByDono
GET http://localhost:8080/api/veiculo/por-dono/{{clienteId}}
Authorization: Bearer {{token}}

### Update Veiculo by ID
# @name updateVeiculoById
PUT http://localhost:8080/api/veiculo/{{veiculoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Placa": "DEF-2G34",
  "DonoId": {{clienteId}},
  "Modelo": "Polo",
  "Marca": "Volkswagen"
}

### Delete Veiculo by ID
# @name deleteVeiculoById
DELETE http://localhost:8080/api/veiculo/{{veiculoId}}
Authorization: Bearer {{token}}

### GET Servicos
# @name getServicos
GET http://localhost:8080/api/servico
Authorization: Bearer {{token}}

### Create Servico
# @name createServico
POST http://localhost:8080/api/servico
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Codigo": "OLE-001",
  "Nome": "Serviço de Óleo",
  "PrecoPadrao": 150.00,
  "Ativo": true
}

### Define Servico ID Variable
@servicoId = {{createServico.response.body.$.id}}

### Get Servico by ID
# @name getServicoById
GET http://localhost:8080/api/servico/{{servicoId}}
Authorization: Bearer {{token}}

### Update Servico by ID
# @name updateServicoById
PUT http://localhost:8080/api/servico/{{servicoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Codigo": "FRE-001",
  "Nome": "Serviço de Freio",
  "PrecoPadrao": 250.00,
  "Ativo": true
}

### Delete Servico by ID
# @name deleteServicoById
DELETE http://localhost:8080/api/servico/{{servicoId}}
Authorization: Bearer {{token}}

### GET Itens de Estoque
# @name getItensEstoque
GET http://localhost:8080/api/itemestoque
Authorization: Bearer {{token}}

### Create Item de Estoque
# @name createItemEstoque
POST http://localhost:8080/api/itemestoque
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Codigo": "ITM-001",
  "Tipo": 0,
  "Nome": "Filtro de Óleo",
  "UnidadeMedida": 0,
  "PrecoVenda": 55.50,
  "Saldo": 10.000,
  "SaldoReservado": 0.000
}

### Define ItemEstoque ID Variable
@itemEstoqueId = {{createItemEstoque.response.body.$.id}}

### Get Item de Estoque by ID
# @name getItemEstoqueById
GET http://localhost:8080/api/itemestoque/{{itemEstoqueId}}
Authorization: Bearer {{token}}

### Update Item de Estoque by ID
# @name updateItemEstoqueById
PUT http://localhost:8080/api/itemestoque/{{itemEstoqueId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Codigo": "ITM-002",
  "Tipo": 1,
  "Nome": "Óleo de Motor",
  "UnidadeMedida": 3,
  "PrecoVenda": 25.00
}

### Delete Item de Estoque by ID
# @name deleteItemEstoqueById
DELETE http://localhost:8080/api/itemestoque/{{itemEstoqueId}}
Authorization: Bearer {{token}}
