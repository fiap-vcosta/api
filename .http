### Login
# @name login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "admin"
}

### Define Token Variable
@token = {{login.response.body.$.token}}

### Health check
# @name healthCheck
GET http://localhost:8080/health

### GET Clientes
# @name getClientes
GET http://localhost:8080/api/cliente
Authorization: Bearer {{token}}

### Create Cliente
# @name createCliente
POST http://localhost:8080/api/cliente
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Nome": "Cliente Teste",
  "TipoDocumento": "0",
  "Documento": "92561324354"
}

### Define Cliente ID Variable
@clienteId = {{createCliente.response.body.$.id}}

### Get Cliente by ID
# @name getClienteById
GET http://localhost:8080/api/cliente/{{clienteId}}
Authorization: Bearer {{token}}

### Update Cliente by ID
# @name updateClienteById
PUT http://localhost:8080/api/cliente/{{clienteId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Nome": "Cliente Teste Atualizado",
  "TipoDocumento": "1",
  "Documento": "29040653186"
}

### Delete Cliente by ID
# @name deleteClienteById
DELETE http://localhost:8080/api/cliente/{{clienteId}}
Authorization: Bearer {{token}}

### GET Veiculos
# @name getVeiculos
GET http://localhost:8080/api/veiculo
Authorization: Bearer {{token}}

### Create Veiculo
# @name createVeiculo
POST http://localhost:8080/api/veiculo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Placa": "ABC-1D23",
  "DonoId": {{clienteId}},
  "Modelo": "Gol",
  "Marca": "Volkswagen"
}

### Define Veiculo ID Variable
@veiculoId = {{createVeiculo.response.body.$.id}}

### Get Veiculo by ID
# @name getVeiculoById
GET http://localhost:8080/api/veiculo/{{veiculoId}}
Authorization: Bearer {{token}}

### Get Veiculos by Dono
# @name getVeiculosByDono
GET http://localhost:8080/api/veiculo/por-dono/{{clienteId}}
Authorization: Bearer {{token}}

### Update Veiculo by ID
# @name updateVeiculoById
PUT http://localhost:8080/api/veiculo/{{veiculoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Placa": "DEF-2G34",
  "DonoId": {{clienteId}},
  "Modelo": "Polo",
  "Marca": "Volkswagen"
}

### Delete Veiculo by ID
# @name deleteVeiculoById
DELETE http://localhost:8080/api/veiculo/{{veiculoId}}
Authorization: Bearer {{token}}
