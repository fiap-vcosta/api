{
  "title": "Tech Challenge — API (demo)",
  "description": "Dashboard da janela de demo: latência APM, erros HTTP, volume/transições de OS (logs), runtime .NET e Cloud SQL (integração GCP).",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "title": "Volume OS recebidas (24h)",
        "type": "query_value",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "logs",
                "name": "query1",
                "indexes": ["*"],
                "compute": {
                  "aggregation": "count"
                },
                "group_by": [],
                "search": {
                  "query": "service:api env:prod \"movida para o status Recebida\""
                },
                "storage": "hot"
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ]
          }
        ],
        "time": {
          "live_span": "1d"
        }
      }
    },
    {
      "definition": {
        "title": "Latência p95 (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "p95:trace.aspnet_core.request{service:api,env:prod}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Erros HTTP (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.aspnet_core.request.errors{service:api,env:prod}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Hits HTTP (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.aspnet_core.request.hits{service:api,env:prod}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
