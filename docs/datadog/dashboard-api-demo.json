{
  "title": "Tech Challenge — API (demo)",
  "description": "Dashboard da janela de demo: latência APM, erros HTTP e transições de OS (logs).",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "title": "Latência p95 (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "p95:trace.aspnet.request{service:api,env:prod}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Erros HTTP (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.aspnet.request.errors{service:api,env:prod}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "OS recebidas (status Recebida)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "data_source": "logs",
                "name": "query1",
                "indexes": ["*"],
                "compute": {
                  "aggregation": "count"
                },
                "group_by": [],
                "search": {
                  "query": "service:api env:prod @Status:Recebida \"movida para o status\""
                }
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Transições OS por status",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "data_source": "logs",
                "name": "query1",
                "indexes": ["*"],
                "compute": {
                  "aggregation": "count"
                },
                "group_by": [
                  {
                    "facet": "@Status",
                    "limit": 20,
                    "sort": {
                      "aggregation": "count",
                      "order": "desc"
                    }
                  }
                ],
                "search": {
                  "query": "service:api env:prod \"movida para o status\""
                }
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runtime .NET — CPU %",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:runtime.dotnet.cpu.percent{service:api,env:prod}",
            "display_type": "line"
          }
        ]
      }
    }
  ]
}
